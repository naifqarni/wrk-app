{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "android",
    "backend",
    "dist",
    "docs",
    "ios",
    "node_modules",
    "scripts",
    "shop-bridge",
    "tests",
    "viewer-src"
  ]
}
