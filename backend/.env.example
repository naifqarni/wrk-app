# Secrets for the edge functions. Set them with `npx supabase secrets set NAME=value`.
# Do NOT put these in the app or in git.

# Required. 64 hex characters. Turns a work email into the one-way hash that is
# the only link between a person and an account. If it is lost or changed,
# nobody can sign back in to their existing account. Keep a copy in a password manager.
EMAIL_PEPPER=

# Required for sending sign-in codes (resend.com, domain wrk.sa verified).
RESEND_API_KEY=
MAIL_FROM=wrk. <noreply@wrk.sa>

# Required for the "I bought from the store" door. The function asks the shop
# whether an order exists for the address. Same value as WRK_BRIDGE_SECRET on the Medusa server.
SHOP_URL=https://api.wrk.sa
SHOP_BRIDGE_SECRET=

# Required for the scheduled jobs (AI sweep, push). 48+ hex characters.
CRON_SECRET=

# Optional: AI moderation. Without it, posts are checked by the word filter only.
ANTHROPIC_API_KEY=
# MODERATION_MODEL=claude-opus-5-5

# Optional: only if Expo "enhanced push security" is on.
# EXPO_ACCESS_TOKEN=

# Optional: testing before the mail provider is set up. The function then returns
# the code in its response (the app prints it to the console). REMOVE before launch.
# DEV_ECHO_CODE=true

# Optional: domain used for the placeholder address on auth users. No mail is ever sent to it.
# SYNTHETIC_EMAIL_DOMAIN=members.wrk.invalid
